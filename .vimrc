syntax on
filetype plugin indent on

set shiftwidth=4
set tabstop=4
set autoindent
set smartindent
set expandtab

set number
set colorcolumn=80
set showmatch

set hlsearch
set incsearch

set cursorline

let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_browse_split = 4
let g:netrw_winsize = 20

nnoremap <C-n> :Lexplore<CR>
